# Copie este arquivo para ".env" e preencha com as credenciais reais.
# NUNCA suba o arquivo ".env" para o Git / compartilhe publicamente.

# Servidor SMTP da Exchange Online / Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Conta usada para autenticar no SMTP.
# Precisa ter permissão "Send As" (ou ser a própria caixa) para MAIL_FROM.
SMTP_USER=IT.Knowledge.Management@vale.com
SMTP_PASS=coloque_a_senha_ou_senha_de_aplicativo_aqui

# Remetente que aparece para quem recebe
MAIL_FROM=IT.Knowledge.Management@vale.com
MAIL_FROM_NAME=IT Knowledge Management

# Lista de Cc fixa (separada por ponto e vírgula), igual à da macro original
CC_LIST=roger.goegan@vale.com;maxsuel.sena@vale.com;cristhian.veiga@vale.com;nycolas.reis@vale.com;IT.Knowledge.Management@vale.com
